# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Supabase (free tier). Project URL and the anon/public key.
# NEVER put the service_role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouteService free key — 2,000 routes/day, 40/min. Not needed until Phase 5.
# https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_API_KEY=

# Path to the FCM credentials file for Android push. Not committed.
# Download from Firebase console → Project settings → Your apps → google-services.json
GOOGLE_SERVICES_JSON=./google-services.json

# Set once an EAS project exists (optional — local builds do not need it).
EAS_PROJECT_ID=
