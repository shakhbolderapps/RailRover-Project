{
  "name": "@railrover/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:both": "expo prebuild --platform all --clean",
    "apk": "bash ../../scripts/build-apk.sh"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@railrover/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "expo": "~57.0.16",
    "expo-application": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.5",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~10.0.0",
    "expo-build-properties": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
